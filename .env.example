# =============================================================================
# DAM MANAGER — variáveis de ambiente
# =============================================================================
# Copie este arquivo para `.env` (local) ou cole as variáveis no painel de
# Variables do Railway (produção).
#
#   cp .env.example .env
#
# NUNCA faça commit do arquivo `.env` — ele está no .gitignore.
# Rode `npm run check` a qualquer momento para ver o que ainda falta.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) SERVIDOR
# -----------------------------------------------------------------------------
# O Railway injeta PORT automaticamente. Localmente o padrão é 3000.
PORT=3000

# development | production
NODE_ENV=development

# URL pública desta aplicação, SEM barra no final.
# Local:      http://localhost:3000
# Railway:    https://<seu-app>.up.railway.app
# É usada para montar a URL do webhook que a Evolution API vai chamar.
APP_URL=http://localhost:3000

# Fuso horário usado para interpretar "hoje", "amanhã", "sexta" nas conversas.
TZ=America/Cuiaba


# -----------------------------------------------------------------------------
# 2) SUPABASE  (https://supabase.com/dashboard → Project Settings → API)
# -----------------------------------------------------------------------------
# Projeto oficial do DAM — ref confirmado no painel do Supabase.
#
# Histórico, para ninguém reintroduzir o valor errado: o supabase.js original
# deste repositório apontava para "sfrovrevzqrfrmmlmpyi", que é OUTRO projeto.
# Apontar para lá não dá erro nenhum — o bot confirma reservas normalmente e
# grava num banco que o painel nunca lê. Se for trocar, confira o ref na URL:
#   supabase.com/dashboard/project/AQUI_ESTA_O_REF/...
SUPABASE_URL=https://xokdjerjpjashyyzweqj.supabase.co

# Chave pública ("anon" / "publishable"). OPCIONAL hoje: nenhuma página do site
# fala direto com o Supabase — o painel passa pela API deste servidor. Fica aqui
# caso você queira, no futuro, ler dados públicos direto do navegador.
# (A chave que estava no repositório era do projeto antigo; não serve mais.)
SUPABASE_ANON_KEY=

# Chave SECRETA ("service_role" / "secret"). Ignora RLS.
# NUNCA exponha no front-end. Só o servidor usa.
# >>> PRECISO QUE VOCÊ ME ENVIE / CADASTRE ESTA <<<
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# 3) OPENAI  (https://platform.openai.com/api-keys)
# -----------------------------------------------------------------------------
# >>> PRECISO QUE VOCÊ ME ENVIE / CADASTRE ESTA <<<
OPENAI_API_KEY=

# Modelo usado pelo chatbot. gpt-4o-mini é rápido e barato para atendimento.
OPENAI_MODEL=gpt-4o-mini

# Máximo de tokens na resposta do bot (mensagens de WhatsApp são curtas).
OPENAI_MAX_TOKENS=600


# -----------------------------------------------------------------------------
# 4) EVOLUTION API  (WhatsApp)
# -----------------------------------------------------------------------------
# URL do serviço Evolution API no Railway, SEM barra no final.
# Ex.: https://evolution-api-production-xxxx.up.railway.app
# >>> PRECISO DESTA URL DEPOIS QUE VOCÊ CRIAR O SERVIÇO (ver docs/EVOLUTION-RAILWAY.md) <<<
EVOLUTION_API_URL=

# Valor de AUTHENTICATION_API_KEY configurado no serviço da Evolution API.
# >>> PRECISO QUE VOCÊ ME ENVIE / CADASTRE ESTA <<<
EVOLUTION_API_KEY=

# Nome da "instância" (a conexão com um número de WhatsApp).
EVOLUTION_INSTANCE=dam

# Segredo compartilhado que protege o endpoint /webhook/evolution.
# Gere um valor aleatório com:  openssl rand -hex 32
# >>> PRECISO QUE VOCÊ GERE E CADASTRE ESTE <<<
WEBHOOK_TOKEN=


# -----------------------------------------------------------------------------
# 5) CHATBOT
# -----------------------------------------------------------------------------
# Liga/desliga as respostas automáticas sem precisar derrubar o serviço.
CHATBOT_ENABLED=true

# Números (com DDI) que o bot deve ignorar — ex.: o celular do gerente.
# Separados por vírgula. Ex.: 5565999999999,5565988888888
CHATBOT_IGNORE_NUMBERS=

# Segundos de espera antes de responder, para agrupar mensagens quebradas
# em várias linhas ("oi" / "queria reservar" / "pra sexta").
CHATBOT_DEBOUNCE_SECONDS=6

# Quantas mensagens anteriores enviar como contexto para o modelo.
CHATBOT_HISTORY_LIMIT=20


# -----------------------------------------------------------------------------
# 6) PAINEL ADMINISTRATIVO
# -----------------------------------------------------------------------------
# Senha para abrir /admin.html. Gere algo forte.
# >>> PRECISO QUE VOCÊ DEFINA ESTA <<<
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# 7) DADOS DO ESTABELECIMENTO (usados pelo bot nas respostas)
# -----------------------------------------------------------------------------
CASA_NOME=DAM Gastrobar
CASA_TELEFONE=5565993378770
CASA_ENDERECO=
CASA_HORARIO=
CASA_CAPACIDADE_MAXIMA=120

# Antecedência mínima (em horas) para aceitar uma reserva pelo bot.
RESERVA_ANTECEDENCIA_HORAS=2

# Maior número de dias no futuro que o bot aceita reservar.
RESERVA_JANELA_DIAS=60
