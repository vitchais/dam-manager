{
  "name": "dam-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Site, painel administrativo e chatbot de WhatsApp do DAM Gastrobar",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch --no-deprecation src/server.js",
    "start": "node --no-deprecation src/server.js",
    "check": "node --no-deprecation scripts/check-config.js",
    "preparar": "node --no-deprecation scripts/preparar-deploy.js",
